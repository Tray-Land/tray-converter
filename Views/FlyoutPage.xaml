<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyConverter.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tiny Converter" />
            <Button
                x:Name="FavoritesMenuButton"
                Grid.Column="1"
                AutomationProperties.Name="Favorites"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Favorites">
                <FontIcon x:Name="FavoritesMenuIcon" FontSize="14" Glyph="&#xE728;" />
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="FavoritesMenu"
                        Opening="FavoritesMenu_Opening"
                        Placement="BottomEdgeAlignedRight" />
                </Button.Flyout>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Converter  -->
        <Border
            Grid.Row="1"
            Padding="16"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <ComboBox
                    x:Name="QuantityBox"
                    HorizontalAlignment="Stretch"
                    Header="Quantity"
                    SelectionChanged="QuantityBox_SelectionChanged" />

                <TextBox
                    x:Name="InputBox"
                    Header="Value (math works: 5 * 12)"
                    PlaceholderText="0"
                    TextChanged="InputBox_TextChanged" />
                <ComboBox
                    x:Name="FromBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="From unit"
                    SelectionChanged="Unit_SelectionChanged" />

                <Grid>
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Swap units"
                        Click="SwapButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Swap units">
                        <FontIcon FontSize="14" Glyph="&#xE174;" />
                    </Button>
                </Grid>

                <ComboBox
                    x:Name="ToBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="To unit"
                    SelectionChanged="Unit_SelectionChanged" />

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ResultText"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="--"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Copy result"
                        Click="CopyButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Copy result">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        x:Name="FavoriteButton"
                        Grid.Column="2"
                        AutomationProperties.Name="Toggle favorite"
                        Click="FavoriteButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Add to favorites">
                        <FontIcon x:Name="FavoriteIcon" FontSize="14" Glyph="&#xE734;" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Overlay for the "added to favorites" flight; never takes input  -->
        <Canvas
            Grid.RowSpan="2"
            Margin="-16,-12,-12,-16"
            IsHitTestVisible="False">
            <FontIcon
                x:Name="FlyStar"
                Canvas.Left="0"
                Canvas.Top="0"
                FontSize="16"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE735;"
                Opacity="0" />
        </Canvas>
    </Grid>
</Page>
