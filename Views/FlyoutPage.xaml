<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyConverter.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tiny Converter" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Favorites: click to jump to that conversion  -->
        <StackPanel x:Name="FavoritesPanel" Grid.Row="1" Spacing="4" Visibility="Collapsed">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Favorites" />
            <ListView
                x:Name="FavoritesList"
                MaxHeight="132"
                IsItemClickEnabled="True"
                ItemClick="FavoritesList_ItemClick"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="Padding" Value="8,0,0,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Remove favorite"
                                Click="RemoveFavorite_Click"
                                Style="{StaticResource FlyoutIconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Remove favorite">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!--  Converter  -->
        <Border
            Grid.Row="2"
            Padding="16"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <ComboBox
                    x:Name="QuantityBox"
                    HorizontalAlignment="Stretch"
                    Header="Quantity"
                    SelectionChanged="QuantityBox_SelectionChanged" />

                <TextBox
                    x:Name="InputBox"
                    Header="Value (math works: 5 * 12)"
                    PlaceholderText="0"
                    TextChanged="InputBox_TextChanged" />
                <ComboBox
                    x:Name="FromBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="From unit"
                    SelectionChanged="Unit_SelectionChanged" />

                <Grid>
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Swap units"
                        Click="SwapButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Swap units">
                        <FontIcon FontSize="14" Glyph="&#xE174;" />
                    </Button>
                </Grid>

                <ComboBox
                    x:Name="ToBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="To unit"
                    SelectionChanged="Unit_SelectionChanged" />

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ResultText"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="--"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Copy result"
                        Click="CopyButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Copy result">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        x:Name="FavoriteButton"
                        Grid.Column="2"
                        AutomationProperties.Name="Toggle favorite"
                        Click="FavoriteButton_Click"
                        Style="{StaticResource FlyoutIconButtonStyle}"
                        ToolTipService.ToolTip="Add to favorites">
                        <FontIcon x:Name="FavoriteIcon" FontSize="14" Glyph="&#xE734;" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
